#!/sbin/sh
# Recovery / direct-zip install path (also used by some managers)
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() {
  echo "ui_print $1" > /proc/self/fd/$OUTFD
  echo "ui_print" > /proc/self/fd/$OUTFD
}
[ -f /data/adb/magisk/busybox ] && export PATH=/data/adb/magisk:$PATH
[ -f /data/adb/ksu/bin/busybox ] && export PATH=/data/adb/ksu/bin:$PATH

TMP=/dev/tmp/usb_dac_manager
rm -rf "$TMP"; mkdir -p "$TMP"
if command -v unzip >/dev/null; then
  unzip -o "$ZIPFILE" -d "$TMP" >&2
else
  busybox unzip -o "$ZIPFILE" -d "$TMP" >&2
fi

# --- clean previous version ---
ui_print "- Clean flash: stop old DAC + wipe dirs"
pkill -f 'usb_dac_ctl.sh' 2>/dev/null
pkill -f 'usb_dac_watch.sh' 2>/dev/null
killall -9 usb_dac_aaudio 2>/dev/null
killall -9 usb_dac_pcm 2>/dev/null
killall -9 volkey_block 2>/dev/null

for d in \
  /data/adb/modules/usb_dac_manager \
  /data/adb/modules_update/usb_dac_manager \
  /data/adb/ksu/modules/usb_dac_manager \
  /data/adb/ksu/modules_update/usb_dac_manager
do
  [ -e "$d" ] && ui_print "  rm $d" && rm -rf "$d"
done

ui_print "  rm /data/adb/usb_dac"
rm -rf /data/adb/usb_dac
rm -rf /data/local/tmp/usb_dac /data/local/tmp/usb_dac_bin 2>/dev/null
rm -f /data/local/tmp/usb_dac*.log /data/local/tmp/usb_dac*.pid \
      /data/local/tmp/usb_dac_gadget.save 2>/dev/null

MODDIR=/data/adb/modules/usb_dac_manager
ui_print "- Installing USB DAC Manager"
mkdir -p "$MODDIR"
cp -af "$TMP"/* "$MODDIR"/
rm -rf "$MODDIR/META-INF"
export MODPATH="$MODDIR"
# customize.sh will wipe runtime again + write fresh config (safe double-clean)
[ -f "$MODDIR/customize.sh" ] && . "$MODDIR/customize.sh"
chmod 755 "$MODDIR"/*.sh "$MODDIR/bin"/* "$MODDIR/scripts"/* 2>/dev/null
ui_print "- Done. Reboot, then open module WebUI"
exit 0
